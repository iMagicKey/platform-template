NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
LOG_OUTPUT=stdout
APP_RELEASE=dev
DOCS_ENABLED=auto
CORS_ORIGINS=
HTTPS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
WS_DEMO_TOKEN=
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
AUTH_MODE=disabled
# Demo auth requires a second explicit opt-in, only on loopback and never in production.
ALLOW_DEMO_AUTH=false
# Demo auth is test/development only. Has a local JSON session store; no production or multi-instance support.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Optional; defaults to apps/backend/storage/auth/sessions.json
# AUTH_FILE_PATH=
AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
