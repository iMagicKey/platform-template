{
    "name": "@platform/backend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=26 <27"
    },
    "scripts": {
        "dev": "tsx watch --env-file=.env code/index.ts",
        "build": "pnpm --filter @platform/api-contract build && tsc -p tsconfig.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "test": "pnpm --filter @platform/api-contract build && tsx --test tests/*.test.ts",
        "typecheck": "pnpm --filter @platform/api-contract build && tsc --noEmit -p tsconfig.json",
        "lint": "eslint code tests"
    },
    "dependencies": {
        "@platform/api-contract": "workspace:*",
        "@fastify/cors": "^11.0.0",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/swagger": "^9.5.0",
        "@fastify/swagger-ui": "^6.1.2",
        "@fastify/type-provider-zod": "^1.0.3",
        "@fastify/websocket": "^11.0.0",
        "fastify": "^5.6.0",
        "jose": "^6.1.0",
        "pino": "^10.4.0",
        "pino-roll": "^4.0.0",
        "zod": "^4.2.0",
        "@fastify/cookie": "^11.1.3"
    }
}
