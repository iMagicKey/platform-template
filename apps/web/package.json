{
    "name": "@platform/web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=26 <27"
    },
    "scripts": {
        "dev": "next dev --hostname 127.0.0.1 --port 3000",
        "build": "pnpm --filter @platform/api-contract build && next build",
        "start": "next start --hostname 127.0.0.1 --port 3000",
        "test": "pnpm --filter @platform/api-contract build && tsx --tsconfig tsconfig.test.json --test src/tests/*.test.ts",
        "typecheck": "pnpm --filter @platform/api-contract build && tsc --noEmit",
        "lint": "eslint src"
    },
    "dependencies": {
        "@platform/api-contract": "workspace:*",
        "next": "^16.4.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "postcss": "^8.5.32"
    }
}
