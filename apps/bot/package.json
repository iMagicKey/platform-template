{
    "name": "@platform/bot",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "platform": {
        "type": "bot"
    },
    "engines": {
        "node": ">=26 <27"
    },
    "scripts": {
        "dev": "tsx watch --env-file=.env code/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "test": "tsx --test ../../tests/bot/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint code"
    },
    "dependencies": {
        "grammy": "^1.46.0",
        "pino": "^10.4.0",
        "pino-roll": "^4.0.0",
        "zod": "^4.2.0"
    }
}
