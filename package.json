{
    "name": "platform-template",
    "version": "0.1.1",
    "private": true,
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26 <27"
    },
    "scripts": {
        "dev": "pnpm --filter @platform/api-contract build && turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.system.json && tsc --noEmit -p tests/tsconfig.json",
        "lint": "turbo run lint && eslint system tests",
        "check": "pnpm check:architecture && pnpm typecheck && pnpm test",
        "check:architecture": "node system/check.ts",
        "dev:web": "pnpm --filter @platform/api-contract build && pnpm --filter @platform/web dev",
        "dev:backend": "pnpm --filter @platform/api-contract build && pnpm --filter @platform/backend dev",
        "dev:api": "pnpm --filter @platform/api-contract build && pnpm --filter @platform/api dev",
        "system:init": "node system/init.ts",
        "system:certs": "node system/certs.ts",
        "system:service": "node system/service.ts",
        "system:logs": "node system/logs.ts",
        "dev:worker": "pnpm --filter @platform/worker dev",
        "dev:bot": "pnpm --filter @platform/bot dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:commit": "node system/commit.ts",
        "test:system": "node --test tests/system/*.test.ts",
        "system:password": "node system/password.ts",
        "system:smoke": "node system/smoke.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "eslint": "^10.14.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "turbo": "^2.11.10",
        "prettier": "^3.9.10",
        "eslint-config-prettier": "^10.1.8"
    },
    "type": "module"
}
