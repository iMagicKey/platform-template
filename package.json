{
  "name": "platform-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "node system/check/index.mjs && pnpm typecheck && pnpm test",
    "check:architecture": "node system/check/index.mjs",
    "dev:web": "pnpm --filter @platform/web dev",
    "dev:backend": "pnpm --filter @platform/backend dev",
    "dev:api": "pnpm --filter @platform/api dev",
    "system:init": "node system/init/index.mjs",
    "system:certs": "node system/certs/index.mjs",
    "system:service": "node system/service/index.mjs",
    "system:logs": "node system/logs/index.mjs",
    "dev:worker": "pnpm --filter @platform/worker dev",
    "dev:bot": "pnpm --filter @platform/bot dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "turbo": "^2.5.0"
  }
}
